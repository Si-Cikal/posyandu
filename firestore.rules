rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data aplikasi Posyandu ILP: settings (jadwal, sandi), cadres, participants,
    // attendances, health, complaints. Hanya pengguna yang sudah login (anonim) yang boleh akses.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
